# 复制本文件为 .env 后填写真实值，.env 不要提交到仓库

# ===== 模型服务（OpenAI 兼容）=====
# 必填
LLM_API_KEY=
# 留空使用默认值：https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=
# 留空使用默认值：glm-4.5-air
LLM_MODEL=
# 留空使用默认值 0.3
LLM_TEMPERATURE=

# ===== Redis（看板数据缓存）=====
# 留空使用默认值 127.0.0.1:6379 / db0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 留空表示无密码
REDIS_PASSWORD=
# 连接超时（秒）
REDIS_TIMEOUT=2

# ===== 一知 AICC（外呼平台对接）=====
AICC_BASE_URL=https://aicc.tanyibot.com
# 看板数据缓存时长（秒），默认 600 = 10 分钟
AICC_DASHBOARD_TTL=600
# 任务运行概况缓存时长（秒），默认 60
AICC_TASK_STATUS_TTL=60
# 完整 Cookie 串（含 token / refresh_token / SERVERID），由 app/clients/tanyibot.py 维护
AICC_COOKIE=
# 登录账号：Cookie 失效时用于自动重新登录
AICC_PHONE=
AICC_PASSWORD=

# ===== 一知回调接收（独立 FastAPI 进程）=====
# AICC 企业 → 开放平台 → 回调配置里的 Token（10 位）
AICC_CALLBACK_TOKEN=
# AICC 企业 → 开放平台 → 回调配置里的 EncodingAESKey（43 位）
AICC_CALLBACK_AES_KEY=
# 只监听本地，由端口映射工具转发到公网
AICC_CALLBACK_HOST=127.0.0.1
AICC_CALLBACK_PORT=8088
AICC_CALLBACK_PATH=/aicc/callback
# 端口映射工具分配的公网地址，仅用于记录与自检，不参与逻辑
AICC_CALLBACK_PUBLIC_URL=

# ===== MySQL =====
# 留空使用默认值 127.0.0.1:3306 / root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# 必填
MYSQL_PASSWORD=
# 必填：已建好的业务库名
MYSQL_DATABASE=

# ===== PostgreSQL（Agent 短期记忆 checkpoint）=====
# 留空使用默认值 127.0.0.1:5432 / postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
# 必填：本机 PostgreSQL 密码
PG_PASSWORD=
# 记忆库名（需先手工建空库，checkpoint 表由程序启动时自动创建）
PG_DATABASE=agent_calling_memory
# checkpoint 表所在 schema
PG_SCHEMA=memory
PG_SSLMODE=disable
# 连接池上限
PG_POOL_MAX=5

# ===== 上下文裁剪（送给模型的最大历史）=====
HISTORY_MAX_ROUNDS=10
HISTORY_MAX_TOKENS=6000

# ===== 飞书企业自建应用机器人 =====
# 开发者后台 → 凭证与基础信息获取；需开启机器人能力与长连接事件订阅
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 群聊默认关闭：只处理单聊消息，记忆按发送人（open_id）隔离
ALLOW_GROUP_CHAT=false

# ===== 本地状态与媒体目录 =====
# 留空使用默认值：项目根目录下的 state/
STATE_DIR=
# 留空使用默认值：state/feishu_media
FEISHU_MEDIA_DIR=
