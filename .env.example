# 复制本文件为 .env 后填写真实值，.env 不要提交到仓库

# ===== 模型服务（OpenAI 兼容）=====
# 必填
LLM_API_KEY=
# 留空使用默认值：https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=
# 留空使用默认值：glm-4.5-air
LLM_MODEL=
# 留空使用默认值 0.3
LLM_TEMPERATURE=
# Agent 单轮最多执行步数，超出会中止并提示重试（默认 12）
AGENT_RECURSION_LIMIT=12

# ===== Redis（看板数据缓存）=====
# 留空使用默认值 127.0.0.1:6379 / db0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 留空表示无密码
REDIS_PASSWORD=
# 连接超时（秒）
REDIS_TIMEOUT=2

# ===== 一知 AICC（外呼平台对接）=====
AICC_BASE_URL=https://aicc.tanyibot.com
# 看板数据缓存时长（秒），默认 600 = 10 分钟
AICC_DASHBOARD_TTL=600
# 任务运行概况缓存时长（秒），默认 60
AICC_TASK_STATUS_TTL=60
# 同时打到一知接口的请求数上限，默认 2；禁止批量并发以免被限流
AICC_MAX_CONCURRENCY=2
# 完整 Cookie 串（含 token / refresh_token / SERVERID），由 app/clients/tanyibot.py 维护
AICC_COOKIE=
# 登录账号：Cookie 失效时用于自动重新登录
AICC_PHONE=
AICC_PASSWORD=

# ===== 话术 BOT 白名单（不再从一知实时拉取）=====
# 新建任务时只能从这里配置的 BOT 中选择，卡片不可手填。
# 格式：ID:展示名，多个用英文逗号分隔；ID 用于调用一知接口，展示名仅用于卡片显示。
# 例：AICC_DIALOG_BOTS=123:11月新客回访,456:续费提醒
AICC_DIALOG_BOTS=

# ===== 一知回调接收（独立 FastAPI 进程）=====
# AICC 企业 → 开放平台 → 回调配置里的 Token（10 位）
AICC_CALLBACK_TOKEN=
# AICC 企业 → 开放平台 → 回调配置里的 EncodingAESKey（43 位）
AICC_CALLBACK_AES_KEY=
# 只监听本地，由端口映射工具转发到公网
AICC_CALLBACK_HOST=127.0.0.1
AICC_CALLBACK_PORT=8088
AICC_CALLBACK_PATH=/aicc/callback
# 端口映射工具分配的公网地址，仅用于记录与自检，不参与逻辑
AICC_CALLBACK_PUBLIC_URL=
# 时间戳允许的偏移秒数（防重放），默认 300；0 表示关闭窗口校验
AICC_CALLBACK_MAX_SKEW_SECONDS=300
# 解密后明文尾部的 receiveid，配置后校验接收方标识；留空跳过
AICC_CALLBACK_RECEIVE_ID=

# ===== MySQL =====
# 留空使用默认值 127.0.0.1:3306 / root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# 必填
MYSQL_PASSWORD=
# 必填：已建好的业务库名
MYSQL_DATABASE=

# ===== PostgreSQL（Agent 短期记忆 checkpoint）=====
# 留空使用默认值 127.0.0.1:5432 / postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
# 必填：本机 PostgreSQL 密码
PG_PASSWORD=
# 记忆库名（需先手工建空库，checkpoint 表由程序启动时自动创建）
PG_DATABASE=agent_calling_memory
# checkpoint 表所在 schema
PG_SCHEMA=memory
PG_SSLMODE=disable
# 连接池上限
PG_POOL_MAX=5

# ===== 上下文裁剪（送给模型的最大历史）=====
HISTORY_MAX_ROUNDS=10
HISTORY_MAX_TOKENS=6000

# ===== 当前运行渠道（单进程单通道）=====
# feishu / wecom / dingtalk；同时决定派单入队走哪个渠道。
# 回调、分析、通知进程必须与聊天进程使用同一个 CHANNEL。
CHANNEL=feishu

# ===== 飞书企业自建应用机器人 =====
# 开发者后台 → 凭证与基础信息获取；需开启机器人能力与长连接事件订阅
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 群聊默认关闭：只处理单聊消息，记忆按发送人（open_id）隔离
ALLOW_GROUP_CHAT=false

# ===== 企业微信智能机器人（第二渠道，长连接）=====
# 企业微信管理后台 → 智能机器人 → API 模式 → 使用长连接，页面生成 Bot ID 与 Secret
# Secret 是长连接专用密钥，不同于自建应用的 Token / EncodingAESKey
WECHAT_BOT_ID=
WECHAT_BOT_SECRET=
# 自建应用凭证：后续用于换取 access_token（通讯录同步、open_userid 转明文 userid）
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_AGENT_SECRET=

# ===== 钉钉企业内部应用（第三渠道，机器人 Stream 模式）=====
# 开发者后台 → 应用开发 → 企业内部应用 → 钉钉应用 → 基础信息 → 凭证与基础信息
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 组织 corpId（本期无 H5 免登，可留空）
DINGTALK_CORP_ID=
# 应用能力 → 机器人 → 机器人 ID（主动发消息的 robotCode）
DINGTALK_ROBOT_CODE=
# 应用标识，预留
DINGTALK_AGENT_ID=
# 卡片平台 → 表单模板 ID；留空使用官方公开测试模板，生产必须换成自有模板
DINGTALK_CARD_TEMPLATE_FORM=
# 派单目标：在 sales_assignee 里填 dingtalk_userid（仅名单内销售参与轮转）
# 待办所需权限：Todo.Todo.Write / Todo.Todo.Read；每人每天相同内容限 1 条、最多 100 条

# ===== 本地状态与媒体目录 =====
# 留空使用默认值：项目根目录下的 state/
STATE_DIR=
# 留空使用默认值：state/feishu_media
FEISHU_MEDIA_DIR=
