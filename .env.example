# 复制本文件为 .env 后填写真实值，.env 不要提交到仓库

# ===== 模型服务（OpenAI 兼容）=====
# 必填
LLM_API_KEY=
# 留空使用默认值：https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=
# 留空使用默认值：glm-4.5-air
LLM_MODEL=
# 留空使用默认值 0.3
LLM_TEMPERATURE=

# ===== 好客搜登录（自动刷新 Cookie 依赖）=====
# 必填：填了就走 OCR 自动登录刷新 Cookie
# 留空则读取 state/.haokesou_cookie（手动复制 PHPSESSID 到这个文件也能跑，但会过期）
HAOKESOU_USERNAME=
HAOKESOU_PASSWORD=

# ===== MySQL =====
# 留空使用默认值 127.0.0.1:3306 / root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# 必填
MYSQL_PASSWORD=
# 必填：已建好的业务库名
MYSQL_DATABASE=

# ===== 飞书企业自建应用机器人 =====
# 开发者后台 → 凭证与基础信息获取；需开启机器人能力与长连接事件订阅
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 本地状态与媒体目录 =====
# 留空使用默认值：项目根目录下的 state/
STATE_DIR=
# 留空使用默认值：state/feishu_media
FEISHU_MEDIA_DIR=
